# Copy to .env.local and fill in. Never commit real values.

# Supabase transaction pooler (Project Settings > Database > Connection string).
# Used at runtime by the app.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# Supabase direct or session-pooler connection. Used only by drizzle-kit
# migrations (npm run db:migrate). Optional; falls back to DATABASE_URL.
DATABASE_URL_DIRECT=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# Which tracking provider to use: "fake" (default; canned data, no network)
# or "ship24". Use "fake" for local development to save Ship24's free quota.
TRACKING_PROVIDER=fake

# Required when TRACKING_PROVIDER=ship24 (Ship24 dashboard: API keys / webhooks).
SHIP24_API_KEY=
SHIP24_WEBHOOK_SECRET=

# Secret the fake provider expects on webhook requests. Defaults to
# "fake-secret" in development; must be set explicitly if NODE_ENV=production.
FAKE_WEBHOOK_SECRET=

# Supabase Auth (Project Settings > API). Used server-side only.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Public origin of this app, used for auth redirect URLs.
# Production: your real https URL. Local default: http://localhost:3000
APP_URL=http://localhost:3000

# Inngest (background jobs)
# Local development: leave INNGEST_DEV=1 and run `npm run jobs:dev`.
# Production: remove INNGEST_DEV and set INNGEST_SIGNING_KEY from the Inngest dashboard (required).
INNGEST_DEV=1
INNGEST_SIGNING_KEY=
